# Copy to .env and export before running, or set these in your shell.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

ES_ACTIVE=local
ES_URL=http://localhost:9200
ES_URL_2=http://localhost:9201
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PREFIX=knowledge_core_

# Personas: a JSON file imported at startup, and an optional fallback for chat bodies that
# name none. Set auto-import to false to start with an empty registry.
PERSONA_SAMPLE_FILE=classpath:sample-data/personas.json
PERSONA_AUTO_IMPORT=true
PERSONA_DEFAULT=

SERVER_PORT=8080
